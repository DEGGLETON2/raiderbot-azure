# RaiderBot Azure Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# Azure AD Authentication (Required)
# ===========================================
AZURE_AD_CLIENT_ID=090b83a0-e016-4d12-9989-4a906a3bf7d8
AZURE_AD_CLIENT_SECRET=your-client-secret-here
AZURE_AD_TENANT_ID=293a9937-d3a3-42b7-ad71-f9e7210a432e

# Auth.js Secret (Required)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# ===========================================
# Snowflake Configuration (Required)
# ===========================================
SNOWFLAKE_ACCOUNT=LI21842-WW07444
SNOWFLAKE_USERNAME=your-snowflake-username
SNOWFLAKE_PASSWORD=your-snowflake-password

# ===========================================
# Optional: Azure Blob Storage (for file uploads)
# ===========================================
# AZURE_STORAGE_CONNECTION_STRING=your-connection-string
# AZURE_STORAGE_CONTAINER_NAME=raiderbot-uploads

# ===========================================
# Optional: Azure Document Intelligence (for document parsing)
# ===========================================
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=your-key-here

# ===========================================
# Development Settings
# ===========================================
NODE_ENV=development
